default_platform(:ios)

XCODE_PROJECT  = File.expand_path("../Builds/iOS/Unity-iPhone.xcodeproj", __dir__)
SCHEME         = "Unity-iPhone"
BUNDLE_ID      = "com.filowatt.K1L0"
TEAM_ID        = "7R2746UPX7"
OUTPUT_DIR     = "./build"
ASC_KEY_ID     = "8YQDST2XPS"
ASC_ISSUER_ID  = "69a6de76-c95b-47e3-e053-5b8c7c11a4d1"
ASC_KEY_PATH   = "/Users/kiloverse/keys/appstoreconnect/AuthKey_8YQDST2XPS.p8"
ENTITLEMENTS   = File.expand_path("../Builds/iOS/Unity-iPhone.entitlements", __dir__)
SIGNING_DIR    = "./build/signing"
APPSTORE_PROFILE_NAME = "K1L0 App Store 1783411478"
BETA_APP_DESCRIPTION = "K1L0 is a location-based field test for discovering, creating, and responding to transmissions in the world."
BETA_FEEDBACK_EMAIL = "ed@filowatt.com"
BETA_GROUPS = ["K1L0 Testers"]
BETA_REVIEW_INFO = {
  contact_email: BETA_FEEDBACK_EMAIL,
  contact_first_name: "Ed",
  contact_last_name: "Filowat",
  contact_phone: "4125550100",
  demo_account_required: false,
  notes: "No demo account is required. Please allow location, motion, camera, microphone, and photo access to test K1L0 transmissions."
}

def k1l0_api_key
  app_store_connect_api_key(
    key_id:       ASC_KEY_ID,
    issuer_id:    ASC_ISSUER_ID,
    key_filepath: ASC_KEY_PATH,
    in_house:     false
  )
end

def strip_k1l0_entitlements
  UI.user_error!("Missing iOS export at #{XCODE_PROJECT}; run Unity BuildiOS first.") unless File.exist?(XCODE_PROJECT)
  File.write(ENTITLEMENTS, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict/>
    </plist>
  PLIST
end

def ensure_k1l0_app_store_signing(api_key)
  get_certificates(
    api_key: api_key,
    team_id: TEAM_ID,
    platform: "ios",
    output_path: SIGNING_DIR,
    generate_apple_certs: true
  )

  get_provisioning_profile(
    api_key: api_key,
    team_id: TEAM_ID,
    app_identifier: BUNDLE_ID,
    provisioning_name: APPSTORE_PROFILE_NAME,
    filename: "K1L0_AppStore.mobileprovision",
    output_path: SIGNING_DIR,
    force: false
  )
end

platform :ios do

  desc "Create/download App Store signing certificate and profile for K1L0."
  lane :signing do
    ensure_k1l0_app_store_signing(k1l0_api_key)
  end

  desc "Archive Release from existing Unity iOS export and upload to TestFlight."
  lane :beta do
    api_key = k1l0_api_key
    strip_k1l0_entitlements
    ensure_k1l0_app_store_signing(api_key)

    build_app(
      project:          XCODE_PROJECT,
      scheme:           SCHEME,
      configuration:    "Release",
      export_method:    "app-store",
      clean:            false,
      output_directory: OUTPUT_DIR,
      output_name:      "K1L0.ipa",
      xcargs:           "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{TEAM_ID} CODE_SIGN_STYLE=Automatic PROVISIONING_PROFILE_SPECIFIER='' PROVISIONING_PROFILE='' CODE_SIGN_ALLOW_ENTITLEMENTS_MODIFICATION=YES",
      export_xcargs:    "-allowProvisioningUpdates",
      export_options:   {
        method: "app-store",
        signingStyle: "automatic",
        teamID: TEAM_ID,
        compileBitcode: false,
        thinning: "<none>",
        provisioningProfiles: {
          BUNDLE_ID => APPSTORE_PROFILE_NAME
        }
      }
    )

    upload_to_testflight(
      api_key:                              api_key,
      app_identifier:                       BUNDLE_ID,
      app_platform:                         "ios",
      ipa:                                  "#{OUTPUT_DIR}/K1L0.ipa",
      skip_waiting_for_build_processing:    false,
      distribute_external:                  true,
      groups:                               BETA_GROUPS,
      submit_beta_review:                   true,
      beta_app_review_info:                 BETA_REVIEW_INFO,
      beta_app_description:                 BETA_APP_DESCRIPTION,
      beta_app_feedback_email:              BETA_FEEDBACK_EMAIL,
      changelog:                            "K1L0 TestFlight build"
    )
  end

  desc "Submit the already-uploaded K1L0 build to external TestFlight review."
  lane :submit_beta do
    api_key = k1l0_api_key

    upload_to_testflight(
      api_key:                              api_key,
      app_identifier:                       BUNDLE_ID,
      app_platform:                         "ios",
      distribute_only:                      true,
      app_version:                          "0.1.0",
      build_number:                         "0",
      distribute_external:                  true,
      groups:                               BETA_GROUPS,
      submit_beta_review:                   true,
      beta_app_review_info:                 BETA_REVIEW_INFO,
      beta_app_description:                 BETA_APP_DESCRIPTION,
      beta_app_feedback_email:              BETA_FEEDBACK_EMAIL,
      changelog:                            "K1L0 TestFlight build"
    )
  end

  desc "Upload an already-built IPA to TestFlight (skip archive)."
  lane :upload do |options|
    api_key = k1l0_api_key
    ipa_path = options[:ipa] || "#{OUTPUT_DIR}/K1L0.ipa"

    upload_to_testflight(
      api_key:                              api_key,
      app_identifier:                       BUNDLE_ID,
      app_platform:                         "ios",
      ipa:                                  ipa_path,
      skip_waiting_for_build_processing:    false,
      distribute_external:                  true,
      groups:                               BETA_GROUPS,
      submit_beta_review:                   true,
      beta_app_review_info:                 BETA_REVIEW_INFO,
      beta_app_description:                 BETA_APP_DESCRIPTION,
      beta_app_feedback_email:              BETA_FEEDBACK_EMAIL,
      changelog:                            "K1L0 TestFlight build"
    )
  end

end
